doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Welcome to DoQuest

    link(href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet")

    style.
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Inter', sans-serif;
        background-color: #f6f7fb;
        color: #1f2430;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2rem 1rem;
      }

      h1, h2, h3 {
        font-family: 'Manrope', sans-serif;
      }

      .container {
        width: 100%;
        max-width: 600px;
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(20, 30, 60, 0.08);
        overflow: hidden;
      }

      .header {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 1.5rem;
        border-bottom: 1px solid #eef0f6;
      }

      .logo-text {
        font-size: 1.5rem;
        font-weight: 800;
        color: #1f2430;
      }

      .logo-text span {
        color: #434E78;
      }

      .content {
        padding: 2.5rem;
      }

      .welcome-banner {
        background: rgba(67, 78, 120, 0.08);
        border-left: 4px solid #434E78;
        padding: 1.5rem;
        border-radius: 10px;
        text-align: center;
        margin-bottom: 1.5rem;
      }

      .welcome-banner h1 {
        font-size: 1.5rem;
        font-weight: 800;
        color: #1f2430;
        margin-bottom: 0.5rem;
      }

      .welcome-banner p {
        font-size: 0.95rem;
        color: #5a6275;
      }

      .greeting {
        font-size: 1rem;
        color: #1f2430;
        margin-bottom: 0.75rem;
      }

      .main-text {
        font-size: 0.95rem;
        color: #5a6275;
        line-height: 1.6;
        margin-bottom: 1.5rem;
      }

      .btn {
        display: inline-block;
        padding: 0.95rem 2.2rem;
        background-color: #434E78;
        color: #ffffff;
        font-weight: 600;
        text-decoration: none;
        border-radius: 10px;
        transition: all 0.2s ease;
      }

      .btn:hover {
        background-color: #353e63;
      }

      .expiry-text {
        font-size: 0.85rem;
        color: #8a90a3;
        margin-top: 1rem;
      }

      .features {
        margin-top: 2rem;
        padding: 1.5rem;
        background: #f6f7fb;
        border-radius: 10px;
      }

      .features h3 {
        font-size: 1rem;
        margin-bottom: 1rem;
        color: #1f2430;
      }

      .feature-item {
        display: flex;
        align-items: center;
        margin: 0.75rem 0;
      }

      .feature-icon {
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 0.75rem;
        color: #434E78;
        font-size: 1rem;
      }

      .feature-item span:last-child {
        font-size: 0.92rem;
        color: #5a6275;
      }

      .signature {
        margin-top: 1.5rem;
        color: #5a6275;
        line-height: 1.6;
      }

      .footer {
        padding: 1.5rem;
        background: #f6f7fb;
        border-top: 1px solid #eef0f6;
        text-align: center;
      }

      .footer-text {
        font-size: 0.75rem;
        color: #8a90a3;
      }

  body
    .container
      .header
        .logo-text
          | Do
          span .
          | Quest

      .content
        .welcome-banner
          h1 Welcome to DoQuest, #{name}! 🎉
          p Your journey toward better productivity starts now

        p.greeting Hello #{name},

        p.main-text
          | Your account has been successfully created. You're now ready to start building habits, tracking progress, and completing quests.

        a.btn(href=resetPasswordLink target="_blank") Set Your Password

        p.expiry-text
          | This link will expire in 24 hours for security reasons.

        .features
          h3 What you can do with DoQuest:
          .feature-item
            .feature-icon 🎯
            span Create and manage daily quests
          .feature-item
            .feature-icon 📊
            span Track progress and achievements
          .feature-item
            .feature-icon ⚡
            span Build consistent habits
          .feature-item
            .feature-icon 👥
            span Share progress with friends

        .signature
          | We're excited to have you on board,
          br
          | The DoQuest Team

      .footer
        .footer-text © #{year || new Date().getFullYear()} DoQuest. All rights reserved.
