doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Welcome to Do.Quest
    style.
      body {
        font-family: Arial, sans-serif;
        background-color: #f9f9f9;
        margin: 0;
        padding: 20px;
      }
      .container {
        max-width: 600px;
        margin: auto;
        background-color: #ffffff;
        padding: 24px;
        border: 1px solid #dddddd;
      }
      .logo {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
      }
      .logo-text {
        font-size: 24px;
        font-weight: bold;
        margin-top: 8px;
        margin-left: 4px;
        color: #333333;
      }
      .logo-text span {
        color: #e46c2a;
      }
      .welcome-banner {
        background: linear-gradient(135deg, #b84f1c 0%, #e46c2a 100%);
        color: white;
        padding: 20px;
        border-radius: 8px;
        text-align: center;
        margin-bottom: 24px;
      }
      .btn {
        display: inline-block;
        padding: 12px 20px;
        background-color: #e46c2a;
        color: #ffffff;
        text-decoration: none;
        border-radius: 4px;
        font-weight: bold;
      }
      .features {
        margin: 24px 0;
        padding: 16px;
        background-color: #f5f5f5;
        border-radius: 8px;
      }
      .feature-item {
        margin: 12px 0;
        display: flex;
        align-items: center;
      }
      .feature-icon {
        margin-right: 12px;
        font-size: 20px;
      }
      .footer {
        margin-top: 32px;
        font-size: 12px;
        color: #666666;
        text-align: center;
        border-top: 1px solid #eeeeee;
        padding-top: 16px;
      }

  body
    .container
      .logo
        svg(width="48" height="48" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg")
          path(d="M12 18C12 15 14 13 17 13H23C26 13 28 15 28 18V28C28 32 25 35 20 35C15 35 12 32 12 28V18Z" fill="#e46c2a")
          ellipse(cx="20" cy="13" rx="6" ry="2" fill="#d35f23")
          path(d="M14 13C14 11.5 16.5 11 20 11C23.5 11 26 11.5 26 13" stroke="#b84f1c" stroke-width="1" fill="none")
          path(d="M16 13C16 12 15.5 11.5 15 12C14.5 12.5 14.5 13.5 15 14C15.5 14.5 16 14 16 13Z" fill="#b84f1c")
          path(d="M24 13C24 12 24.5 11.5 25 12C25.5 12.5 25.5 13.5 25 14C24.5 14.5 24 14 24 13Z" fill="#b84f1c")
          path(
            d="M20 17L20 15.5M20 28.5L20 27M22.5 19.5C22.5 18.1 21.4 17 20 17C18.6 17 17.5 18.1 17.5 19.5C17.5 20.9 18.6 22 20 22C21.4 22 22.5 23.1 22.5 24.5C22.5 25.9 21.4 27 20 27C18.6 27 17.5 25.9 17.5 24.5"
            stroke="#ffffff"
            stroke-width="2"
            stroke-linecap="round"
            fill="none"
          )

        div.logo-text
          | Do
          span .
          | Quest

      .welcome-banner
        h1 Welcome to DoQuest, #{name}! 🎉
        p Your account has been successfully created

      p Hello #{name},

      p Thank you for joining DoQuest! We're excited to have you on board. Your account has been created successfully, and you're just one step away from getting started.

      p(style="text-align: center; margin: 24px 0;")
        a.btn(href=`${resetPasswordLink}` target="_blank") Set Your Password

      p For security reasons, please click the button above to set your password. This link will expire in 24 hours.

      .features
        h3 What you can do with DoQuest:
        .feature-item
          span.feature-icon ✅
          span Create and manage your daily quests
        .feature-item
          span.feature-icon 📊
          span Track your progress and achievements
        .feature-item
          span.feature-icon 🎯
          span Set goals and build productive habits
        .feature-item
          span.feature-icon 👥
          span Connect with friends and share your journey

      p If you have any questions or need assistance, our support team is here to help!

      p Best regards,<br>The DoQuest Team

      .footer
        p © #{year} Do.Quest All rights reserved.
        p This email was sent to #{email}