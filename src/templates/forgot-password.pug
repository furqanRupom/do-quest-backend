doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Reset Your Password - DoQuest
    link(href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&family=Inter:wght@400;500;600&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet")
    link(href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet")
    style.
      /* CSS Reset */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      /* Material Symbols */
      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        display: inline-block;
        line-height: 1;
        text-transform: none;
        letter-spacing: normal;
        word-wrap: normal;
        white-space: nowrap;
        direction: ltr;
      }

      /* Base Styles */
      body {
        font-family: 'Inter', sans-serif;
        background-color: #faf9f6;
        color: #2d2f2f;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2rem 1rem;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      h1, h2, h3, .brand-font {
        font-family: 'Manrope', sans-serif;
      }

      /* Layout */
      .container {
        width: 100%;
        max-width: 600px;
        background-color: #ffffff;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        overflow: hidden;
      }

      /* Header */
      .header {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 1.5rem;
        background-color: #ffffff;
        border-bottom: 1px solid #eeeeee;
      }

      .logo {
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .logo-text {
        font-size: 1.5rem;
        font-weight: 700;
        margin-top: 0.5rem;
        margin-left: 0.25rem;
        color: #333333;
        font-family: 'Manrope', sans-serif;
      }

      .logo-text span {
        color: #fe7f3c;
      }

      /* Content */
      .content {
        padding: 2rem;
        text-align: center;
      }

      .icon-wrapper {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 4rem;
        height: 4rem;
        border-radius: 50%;
        background-color: #fff3ed;
        color: #fe7f3c;
        margin-bottom: 1.5rem;
      }

      .icon-wrapper .material-symbols-outlined {
        font-size: 2.5rem;
      }

      .title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #333333;
        margin-bottom: 1rem;
      }

      .greeting {
        font-size: 1rem;
        color: #666666;
        margin-bottom: 0.5rem;
      }

      .main-text {
        font-size: 1rem;
        color: #666666;
        line-height: 1.6;
        margin-bottom: 1.5rem;
      }

      .secondary-text {
        font-size: 0.875rem;
        color: #888888;
        margin-top: 1rem;
      }

      /* Button */
      .button-wrapper {
        margin: 1.5rem 0;
        text-align: center;
      }

      .btn {
        display: inline-block;
        padding: 0.875rem 2rem;
        background-color: #fe7f3c;
        color: #ffffff;
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
        border-radius: 6px;
        transition: background-color 0.15s ease;
        cursor: pointer;
      }

      .btn:hover {
        background-color: #ed7330;
      }

      .expiry-text {
        font-size: 0.875rem;
        color: #888888;
      }

      /* Security Tip */
      .security-tip {
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #eeeeee;
        text-align: left;
      }

      .tip-box {
        background-color: #faf9f6;
        padding: 1rem;
        border-radius: 6px;
      }

      .tip-label {
        font-size: 0.75rem;
        color: #888888;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
        margin-bottom: 0.5rem;
      }

      .tip-text {
        font-size: 0.875rem;
        color: #666666;
      }

      /* Footer */
      .footer {
        padding: 1.5rem 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 0.75rem;
        background-color: #f5f5f5;
        border-top: 1px solid #eeeeee;
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1.5rem;
      }

      .footer-link {
        color: #888888;
        font-size: 0.75rem;
        text-decoration: none;
        transition: color 0.15s ease;
      }

      .footer-link:hover {
        color: #fe7f3c;
      }

      .footer-text {
        color: #888888;
        font-size: 0.75rem;
      }

  body
    .container
      //- Header
      .header
        .logo
          svg(width="48" height="48" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg")
            path(d="M12 18C12 15 14 13 17 13H23C26 13 28 15 28 18V28C28 32 25 35 20 35C15 35 12 32 12 28V18Z" fill="#fe7f3c")
            ellipse(cx="20" cy="13" rx="6" ry="2" fill="#ed7330")
            path(d="M14 13C14 11.5 16.5 11 20 11C23.5 11 26 11.5 26 13" stroke="#d96820" stroke-width="1" fill="none")
            path(d="M16 13C16 12 15.5 11.5 15 12C14.5 12.5 14.5 13.5 15 14C15.5 14.5 16 14 16 13Z" fill="#d96820")
            path(d="M24 13C24 12 24.5 11.5 25 12C25.5 12.5 25.5 13.5 25 14C24.5 14.5 24 14 24 13Z" fill="#d96820")
            path(
              d="M20 17L20 15.5M20 28.5L20 27M22.5 19.5C22.5 18.1 21.4 17 20 17C18.6 17 17.5 18.1 17.5 19.5C17.5 20.9 18.6 22 20 22C21.4 22 22.5 23.1 22.5 24.5C22.5 25.9 21.4 27 20 27C18.6 27 17.5 25.9 17.5 24.5"
              stroke="#ffffff"
              stroke-width="2"
              stroke-linecap="round"
              fill="none"
            )
          .logo-text
            | Do
            span .
            | Quest

      //- Content
      .content
        .icon-wrapper
          span.material-symbols-outlined lock_reset

        h1.title Password Reset Request

        p.greeting Hello #{name},

        p.main-text
          | We received a request to reset the password for your DoQuest account.

        .button-wrapper
          a.btn(href=resetPasswordLink target="_blank") Reset Password

        p.expiry-text
          | This password reset link will expire in #{expiryTime} minutes.

        p.secondary-text
          | If you did not request a password reset, please ignore this email. Your account remains secure.

        .security-tip
          .tip-box
            p.tip-label Security Tip
            p.tip-text
              | For your security, this link will expire in 24 hours. Never share your password reset link with anyone else.

      //- Footer
      .footer
        .footer-links
          a.footer-link(href="#") Unsubscribe
          a.footer-link(href="#") Privacy Policy
          a.footer-link(href="#") Contact Us
        .footer-text
          | 123 Kinetic Way, Editorial City
        .footer-text
          | © #{year || new Date().getFullYear()} Do.Quest All rights reserved.