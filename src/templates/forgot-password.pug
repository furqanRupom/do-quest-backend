doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Reset Your Password - Do.Quest

    link(href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet")

    style.
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Inter', sans-serif;
        background-color: #f6f7fb;
        color: #1f2430;
        -webkit-font-smoothing: antialiased;
      }

      table {
        border-collapse: collapse;
      }

      h1, h2, h3 {
        font-family: 'Manrope', sans-serif;
      }

      .container {
        width: 100%;
        max-width: 600px;
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(20, 30, 60, 0.08);
        overflow: hidden;
      }

      .header {
        text-align: center;
        padding: 1.5rem;
        border-bottom: 1px solid #eef0f6;
      }

      .logo-text {
        display: inline-block;
        font-size: 1.5rem;
        font-weight: 800;
        color: #1f2430;
      }

      .logo-text span {
        color: #434E78;
      }

      .content {
        padding: 2.5rem;
        text-align: center;
      }

      .title {
        font-size: 1.75rem;
        font-weight: 800;
        margin-bottom: 1rem;
      }

      .greeting {
        font-size: 1rem;
        color: #5a6275;
        margin-bottom: 0.5rem;
      }

      .main-text {
        font-size: 0.95rem;
        color: #5a6275;
        line-height: 1.6;
        margin-bottom: 1.5rem;
      }

      .btn {
        display: inline-block;
        padding: 0.95rem 2.2rem;
        background-color: #434E78;
        color: #ffffff;
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
        border-radius: 10px;
      }

      .expiry-text,
      .secondary-text {
        margin-top: 1rem;
        font-size: 0.85rem;
        color: #8a90a3;
      }

      .security-tip {
        margin-top: 2rem;
        text-align: left;
      }

      .tip-box {
        background: #f6f7fb;
        border-left: 4px solid #434E78;
        padding: 1rem;
        border-radius: 10px;
      }

      .tip-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        color: #434E78;
        font-weight: 700;
        margin-bottom: 0.5rem;
      }

      .tip-text {
        font-size: 0.9rem;
        color: #5a6275;
        line-height: 1.5;
      }

      .footer {
        padding: 1.5rem;
        background-color: #f6f7fb;
        border-top: 1px solid #eef0f6;
        text-align: center;
      }

      .footer-links {
        margin-bottom: 0.75rem;
      }

      .footer-link {
        margin: 0 0.75rem;
        font-size: 0.75rem;
        color: #8a90a3;
        text-decoration: none;
      }

      .footer-text {
        font-size: 0.75rem;
        color: #8a90a3;
      }

  body
    table(width="100%" bgcolor="#f6f7fb")
      tr
        td(align="center")
          table.container
            tr
              td.header
                .logo-text
                  | Do
                  span .
                  | Quest

            tr
              td.content
                h1.title Reset Your Password

                p.greeting Hello #{name},

                p.main-text
                  | We received a request to reset your DoQuest account password.

                a.btn(href=resetPasswordLink target="_blank") Reset Password

                p.expiry-text This link expires in #{expiryTime} minutes.

                p.secondary-text
                  | If you did not request this, you can safely ignore this email.

                .security-tip
                  .tip-box
                    p.tip-label Security Tip
                    p.tip-text
                      | Never share your reset link. It will expire automatically.

            tr
              td.footer
                .footer-links
                  a.footer-link(href="#") Privacy
                  a.footer-link(href="#") Support
                  a.footer-link(href="#") Contact

                .footer-text
                  | © #{year || new Date().getFullYear()} DoQuest
