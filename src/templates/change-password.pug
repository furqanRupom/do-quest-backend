doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Password Change Required
    style.
      body {
        font-family: Arial, sans-serif;
        background-color: #f9f9f9;
        margin: 0;
        padding: 20px;
      }
      .container {
        max-width: 600px;
        margin: auto;
        background-color: #ffffff;
        padding: 24px;
        border: 1px solid #dddddd;
      }
      .logo {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
      }
      .logo-text {
        font-size: 24px;
        font-weight: bold;
        margin-top: 8px;
        margin-left: 4px;
        color: #333333;
      }
      .logo-text span {
        color: #e46c2a;
      }
      .warning-banner {
        background: linear-gradient(135deg, #e46c2a 0%, #e7783d 100%);
        color: white;
        padding: 20px;
        border-radius: 8px;
        text-align: center;
        margin-bottom: 24px;
      }
      .btn {
        display: inline-block;
        padding: 12px 20px;
        background-color: #e46c2a;
        color: #ffffff;
        text-decoration: none;
        border-radius: 4px;
        font-weight: bold;
      }
      .security-notice {
        margin: 24px 0;
        padding: 16px;
        background-color: #fff3cd;
        border: 1px solid #ffeaa7;
        border-radius: 8px;
        color: #856404;
      }
      .tips {
        margin: 24px 0;
        padding: 16px;
        background-color: #f8f9fa;
        border-radius: 8px;
      }
      .tip-item {
        margin: 12px 0;
        padding-left: 20px;
        position: relative;
      }
      .tip-item:before {
        content: "💡";
        position: absolute;
        left: -5px;
        top: 0;
      }
      .footer {
        margin-top: 32px;
        font-size: 12px;
        color: #666666;
        text-align: center;
        border-top: 1px solid #eeeeee;
        padding-top: 16px;
      }

  body
    .container
      .logo
        svg(width="48" height="48" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg")
          path(d="M12 18C12 15 14 13 17 13H23C26 13 28 15 28 18V28C28 32 25 35 20 35C15 35 12 32 12 28V18Z" fill="#e46c2a")
          ellipse(cx="20" cy="13" rx="6" ry="2" fill="#d35f23")
          path(d="M14 13C14 11.5 16.5 11 20 11C23.5 11 26 11.5 26 13" stroke="#b84f1c" stroke-width="1" fill="none")
          path(d="M16 13C16 12 15.5 11.5 15 12C14.5 12.5 14.5 13.5 15 14C15.5 14.5 16 14 16 13Z" fill="#b84f1c")
          path(d="M24 13C24 12 24.5 11.5 25 12C25.5 12.5 25.5 13.5 25 14C24.5 14.5 24 14 24 13Z" fill="#b84f1c")
          path(
            d="M20 17L20 15.5M20 28.5L20 27M22.5 19.5C22.5 18.1 21.4 17 20 17C18.6 17 17.5 18.1 17.5 19.5C17.5 20.9 18.6 22 20 22C21.4 22 22.5 23.1 22.5 24.5C22.5 25.9 21.4 27 20 27C18.6 27 17.5 25.9 17.5 24.5"
            stroke="#ffffff"
            stroke-width="2"
            stroke-linecap="round"
            fill="none"
          )

        div.logo-text
          | Do
          span .
          | Quest

      .warning-banner
        h1 ⚠️ Password Change Required
        p Action needed to access your account

      p Hello #{name},

      p We noticed that your account requires a password update. This is a security measure to ensure your account remains protected.

      .security-notice
        strong 🔒 Security Notice:
        p For your protection, you won't be able to access your account until you set a new password.

      p(style="text-align: center; margin: 24px 0;")
        a.btn(href=`${resetPasswordLink}` target="_blank") Change Your Password

      p This password reset link will expire in 1 hour for security reasons.

      .tips
        h3 Tips for a Strong Password:
        .tip-item Use at least 8 characters
        .tip-item Include uppercase and lowercase letters
        .tip-item Add numbers and special characters
        .tip-item Avoid using personal information
        .tip-item Don't reuse passwords from other sites

      p After setting your new password, you'll be able to log in and continue your quest journey!

      p If you didn't attempt to log in or if this seems suspicious, please contact our support team immediately.

      p Stay secure,<br>The DoQuest Team

      .footer
        p © #{year} Do.Quest All rights reserved.
        p This is an automated security message from DoQuest.
        p If you need help, contact us at support@doquest.com