doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Password Change Required - DoQuest

    link(href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet")

    style.
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Inter', sans-serif;
        background-color: #f6f7fb;
        color: #1f2430;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2rem 1rem;
        -webkit-font-smoothing: antialiased;
      }

      h1, h2, h3, .brand-font {
        font-family: 'Manrope', sans-serif;
      }

      .container {
        width: 100%;
        max-width: 600px;
        background-color: #ffffff;
        border-radius: 10px;
        box-shadow: 0 10px 30px rgba(20, 30, 60, 0.08);
        overflow: hidden;
      }

      .header {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 1.5rem;
        border-bottom: 1px solid #eef0f6;
      }

      .logo-text {
        font-size: 1.5rem;
        font-weight: 800;
        margin-left: 0.3rem;
        color: #1f2430;
      }

      .logo-text span {
        color: #434E78;
      }

      .content {
        padding: 2rem;
      }

      .warning-banner {
        background-color: rgba(67, 78, 120, 0.08);
        border-left: 4px solid #434E78;
        padding: 1.5rem;
        border-radius: 8px;
        text-align: center;
        margin-bottom: 1.5rem;
      }

      .warning-banner h1 {
        font-size: 1.5rem;
        font-weight: 800;
        color: #1f2430;
        margin-bottom: 0.5rem;
      }

      .warning-banner p {
        font-size: 0.95rem;
        color: #5a6275;
      }

      .greeting {
        font-size: 1rem;
        margin-bottom: 0.75rem;
        color: #1f2430;
      }

      .main-text {
        font-size: 0.95rem;
        color: #5a6275;
        line-height: 1.6;
        margin-bottom: 1rem;
      }

      .security-notice {
        margin: 1.5rem 0;
        padding: 1.25rem;
        background-color: rgba(67, 78, 120, 0.06);
        border-left: 4px solid #434E78;
        border-radius: 8px;
      }

      .security-notice strong {
        color: #434E78;
        font-size: 0.95rem;
        display: block;
        margin-bottom: 0.5rem;
      }

      .security-notice p {
        color: #5a6275;
        font-size: 0.95rem;
        line-height: 1.5;
      }

      .button-wrapper {
        margin: 1.5rem 0;
        text-align: center;
      }

      .btn {
        display: inline-block;
        padding: 0.9rem 2rem;
        background-color: #434E78;
        color: #ffffff;
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
        border-radius: 8px;
        transition: all 0.2s ease;
      }

      .btn:hover {
        background-color: #353e63;
      }

      .expiry-text {
        font-size: 0.85rem;
        color: #8a90a3;
      }

      .tips {
        margin-top: 1.5rem;
        padding: 1.25rem;
        background-color: #f6f7fb;
        border-radius: 8px;
      }

      .tips h3 {
        font-size: 1rem;
        margin-bottom: 1rem;
        color: #1f2430;
      }

      .tip-item {
        margin: 0.6rem 0;
        padding-left: 1.5rem;
        position: relative;
        font-size: 0.92rem;
        color: #5a6275;
      }

      .tip-item:before {
        content: "•";
        position: absolute;
        left: 0;
        color: #434E78;
        font-weight: bold;
      }

      .signature {
        margin-top: 1.5rem;
        color: #5a6275;
        line-height: 1.6;
      }

      .footer {
        padding: 1.5rem 2rem;
        text-align: center;
        background-color: #f6f7fb;
        border-top: 1px solid #eef0f6;
      }

      .footer-text {
        font-size: 0.75rem;
        color: #8a90a3;
      }

  body
    .container
      .header
        .logo-text
          | Do
          span .
          | Quest

      .content
        .warning-banner
          h1 ⚠️ Password Change Required
          p Action required to secure your account

        p.greeting Hello #{name},

        p.main-text
          | We detected a request requiring a password update to keep your account secure.

        .security-notice
          strong 🔒 Security Notice
          p You will not be able to access your account until you set a new password.

        .button-wrapper
          a.btn(href=resetPasswordLink target="_blank") Update Password

        p.expiry-text This link expires in 1 hour.

        .tips
          h3 Password Tips
          .tip-item Use 8+ characters
          .tip-item Mix letters and numbers
          .tip-item Avoid personal info
          .tip-item Don't reuse passwords

        .signature
          | Stay secure,
          br
          | DoQuest Team

      .footer
        .footer-text © #{year || new Date().getFullYear()} DoQuest. All rights reserved.
        .footer-text Automated security message
        .footer-text support@doquest.com
